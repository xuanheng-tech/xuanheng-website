---
import type { SiteContent } from '../i18n/types';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { contact } = content;
---

<BaseLayout content={content} pageKey="contact">
  <section class="contact-page" aria-labelledby="contact-page-title">
    <div class="container contact-page__inner">
      <p class="eyebrow">{contact.kicker}</p>
      <h1 id="contact-page-title">{contact.title}</h1>

      <section class="contact-demo" id="demo" aria-labelledby="contact-demo-title">
        <h2 id="contact-demo-title">{contact.demo.title}</h2>
        <p class="contact-demo__lead">{contact.demo.lead}</p>
        <ul class="contact-demo__checklist">
          {contact.demo.checklist.map((item) => <li>{item}</li>)}
        </ul>
        <a
          class="button button--accent"
          href={`mailto:contact@xuanhengtech.cn?subject=${encodeURIComponent(contact.demo.mailSubject)}`}
        >
          <span>{contact.demo.buttonLabel}</span>
          <span aria-hidden="true">↗</span>
        </a>
        <p class="contact-demo__phone">
          <span>{contact.phone.label}</span><a href={contact.phone.href}>{contact.phone.display}</a>
          <span>{contact.phone.hours}</span>
        </p>
      </section>

      <div class="contact-page__card">
        <div class="contact-page__company">
          {contact.companyLines.map((line) => <p>{line}</p>)}
        </div>
        <div class="contact-page__channels">
          <div class="contact-channel">
            <p class="contact-channel__label">{contact.emailLabel}</p>
            <a class="contact-channel__value" href="mailto:contact@xuanhengtech.cn">
              <span>contact@xuanhengtech.cn</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="contact-channel">
            <p class="contact-channel__label">{contact.phone.label}</p>
            <a class="contact-channel__value" href={contact.phone.href}>
              <span>{contact.phone.display}</span>
              <span aria-hidden="true">↗</span>
            </a>
            <p class="contact-channel__note">{contact.phone.hours}</p>
          </div>
          {contact.x && (
            <div class="contact-channel">
              <p class="contact-channel__label" lang="en">{contact.x.label}</p>
              <a
                class="contact-channel__value"
                href={contact.x.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span lang="en">{contact.x.value}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          )}
          {(contact.wechat || contact.wecom) && (
          <div class="contact-qr-row">
          {contact.wechat && (
            <div class="contact-channel">
              <p class="contact-channel__label">{contact.wechat.label}</p>
              <figure class="contact-channel__qr">
                <img
                  src={contact.wechat.image}
                  width="430"
                  height="430"
                  alt={contact.wechat.imageAlt}
                />
                <figcaption>{contact.wechat.caption}</figcaption>
              </figure>
            </div>
          )}
          {contact.wecom && (
            <div class="contact-channel">
              <p class="contact-channel__label">{contact.wecom.label}</p>
              <figure class="contact-channel__qr">
                <img
                  src={contact.wecom.image}
                  width="430"
                  height="430"
                  alt={contact.wecom.imageAlt}
                />
                <figcaption>{contact.wecom.caption}</figcaption>
              </figure>
            </div>
          )}
          </div>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
