---
import type { SiteContent } from '../i18n/types';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { contact } = content;
---

<BaseLayout content={content} pageKey="contact">
  <section class="contact-page" aria-labelledby="contact-page-title">
    <div class="container contact-page__inner">
      <p class="eyebrow">{contact.kicker}</p>
      <h1 id="contact-page-title">{contact.title}</h1>

      <div class="contact-page__card">
        <div class="contact-page__company">
          {contact.companyLines.map((line) => <p>{line}</p>)}
        </div>
        <div class="contact-page__channels">
          <div class="contact-channel">
            <p class="contact-channel__label">{contact.emailLabel}</p>
            <a class="contact-channel__value" href="mailto:contact@xuanhengtech.cn">
              <span>contact@xuanhengtech.cn</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
          {contact.x && (
            <div class="contact-channel">
              <p class="contact-channel__label" lang="en">{contact.x.label}</p>
              <a
                class="contact-channel__value"
                href={contact.x.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span lang="en">{contact.x.value}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          )}
          {contact.wechat && (
            <div class="contact-channel">
              <p class="contact-channel__label">{contact.wechat.label}</p>
              <figure class="contact-channel__qr">
                <img
                  src={contact.wechat.image}
                  width="430"
                  height="430"
                  alt={contact.wechat.imageAlt}
                />
                <figcaption>{contact.wechat.caption}</figcaption>
              </figure>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
