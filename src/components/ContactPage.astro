---
import type { SiteContent } from '../i18n/types';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { contact } = content;
---

<BaseLayout content={content} pageKey="contact">
  <section class="contact-page" aria-labelledby="contact-page-title">
    <div class="container contact-page__inner">
      <p class="eyebrow">{contact.kicker}</p>
      <h1 id="contact-page-title">{contact.title}</h1>

      <div class="contact-page__card">
        <div class="contact-page__company">
          {contact.companyLines.map((line) => <p>{line}</p>)}
        </div>
        <div class="contact-page__channels">
          <a class="contact-page__email" href="mailto:contact@xuanhengtech.cn">
            <span>contact@xuanhengtech.cn</span>
            <span aria-hidden="true">↗</span>
          </a>
          {contact.x && (
            <a
              class="contact-page__social"
              href={contact.x.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span lang="en">{contact.x.label}</span>
              <span aria-hidden="true">↗</span>
            </a>
          )}
          {contact.wechat && (
            <figure class="contact-page__wechat">
              <img
                src={contact.wechat.image}
                width="430"
                height="430"
                alt={contact.wechat.imageAlt}
              />
              <figcaption>
                <strong>{contact.wechat.label}</strong>
                <span>{contact.wechat.caption}</span>
              </figcaption>
            </figure>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
