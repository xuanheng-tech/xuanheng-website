---
import type { ProjectMediaAsset } from '../i18n/types';

interface Props {
  title: string;
  layers: string[];
  media?: ProjectMediaAsset[];
}

const { title, layers, media = [] } = Astro.props;
const systemMedia = media.filter((asset) => asset.placement === 'system');
---

<section class="project-system-view" aria-labelledby="project-system-view-title">
  <div class="container">
    <header class="project-section__heading project-section__heading--light">
      <p class="eyebrow" lang="en">04 · System View</p>
      <h2 id="project-system-view-title">{title}</h2>
    </header>
    <ol class="project-system-view__layers">
      {layers.map((layer, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <p>{layer}</p>
        </li>
      ))}
    </ol>

    {systemMedia.map((asset) => (
      <figure class:list={['project-figure', 'project-figure--plate', asset.kind === 'screenshot' && 'project-figure--shot']}>
        <picture>
          {asset.mobileSrc && (
            <source
              media="(max-width: 1023px)"
              srcset={asset.mobileSrc}
              width={asset.mobileWidth}
              height={asset.mobileHeight}
            />
          )}
          <img
            src={asset.src}
            alt={asset.alt}
            width={asset.width}
            height={asset.height}
            loading="lazy"
            decoding="async"
          />
        </picture>
        {asset.caption && <figcaption>{asset.caption}</figcaption>}
      </figure>
    ))}
  </div>
</section>
