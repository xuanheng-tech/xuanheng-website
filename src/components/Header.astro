---
import { pageOrder, routeFor } from '../i18n/routes';
import type { PageKey, SiteContent } from '../i18n/types';
import BrandMark from './BrandMark.astro';
import ThemeSwitch from './ThemeSwitch.astro';

interface Props {
  content: SiteContent;
  pageKey: PageKey;
  activePage?: PageKey | null;
  englishPath: string;
  chinesePath: string;
}

const {
  content,
  pageKey,
  activePage = pageKey,
  englishPath,
  chinesePath,
} = Astro.props;
const demoHref = `${routeFor(content.locale, 'contact')}#demo`;
---

<header class="site-header">
  <div class="container header__inner">
    <a
      class="brand"
      href={routeFor(content.locale, 'home')}
      aria-label={content.chrome.brandHomeLabel}
    >
      <BrandMark class="brand__mark" />
      <span class="brand__text">
        <span class="brand__zh">玄衡科技</span>
        <span class="brand__en" lang="en">XUANHENG TECHNOLOGY</span>
      </span>
    </a>

    <div class="header__actions">
      <nav class="desktop-nav" aria-label={content.chrome.mainNavigationLabel}>
        <ul>
          {pageOrder.map((item) => (
            <li>
              <a
                href={routeFor(content.locale, item)}
                aria-current={item === activePage ? 'page' : undefined}
              >
                {content.navigation[item]}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <ThemeSwitch content={content} class="theme-switch--header" />

      <a class="header-cta" href={demoHref}>{content.chrome.demoCta}</a>

      <details class="mobile-menu">
        {/* WCAG 2.5.3 Label in Name: aria-label replaces content, so the accessible
            name has to contain what is actually painted. The visible label is the Latin
            "MENU" on both routes, and the zh string ('导航菜单') did not contain it. */}
        <summary aria-label={`${content.chrome.mobileMenuLabel} MENU`}>
          <span class="mobile-menu__label" lang="en">MENU</span>
          <span class="mobile-menu__icon" aria-hidden="true"></span>
        </summary>
        <nav aria-label={content.chrome.mobileNavigationLabel}>
          <ul>
            {pageOrder.map((item) => (
              <li>
                <a
                  href={routeFor(content.locale, item)}
                  aria-current={item === activePage ? 'page' : undefined}
                >
                  {content.navigation[item]}
                </a>
              </li>
            ))}
            <li>
              <a
                class="mobile-menu__cta"
                href={demoHref}
                aria-current={activePage === 'contact' ? 'page' : undefined}
              >
                {content.chrome.demoCta}
              </a>
            </li>
          </ul>
          <div class="mobile-menu__theme">
            <span>{content.chrome.themeSwitchLabel}</span>
            <ThemeSwitch content={content} />
          </div>
        </nav>
      </details>

      <nav class="language-switch" aria-label={content.chrome.languageSwitcherLabel}>
        <a
          href={englishPath}
          lang="en"
          aria-current={content.locale === 'en' ? 'page' : undefined}
        >EN</a>
        <span aria-hidden="true">|</span>
        <a
          href={chinesePath}
          lang="zh-CN"
          aria-current={content.locale === 'zh' ? 'page' : undefined}
        >中文</a>
      </nav>
    </div>
  </div>
</header>
