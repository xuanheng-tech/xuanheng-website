---
import type { ProjectCopy, ProjectLabels, ProjectMediaAsset } from '../i18n/types';

interface Props {
  project: ProjectCopy;
  labels: ProjectLabels;
  media?: ProjectMediaAsset[];
}

const { project, labels, media = [] } = Astro.props;
const showEnglishName = project.englishName !== project.name;
// Latin-script product names keep the serif face so the name looks identical in both locales.
const latinTitle = !/[\u3400-\u9fff]/.test(project.name);
const heroMedia = media.filter((asset) => asset.placement === 'hero');
---

<header class="project-hero">
  <div class="container">
    <p class="eyebrow" lang="en">
      {labels.project} {project.number} · {project.category}
    </p>
    <div class="project-hero__grid">
      <div class="project-hero__copy">
        <h1 class:list={{ 'project-hero__title--latin': latinTitle }}>{project.name}</h1>
        {showEnglishName && (
          <p class="project-hero__english-name" lang="en">{project.englishName}</p>
        )}
        <p class="project-hero__summary">{project.summary}</p>
      </div>

      <div class="project-hero__meta">
        <p class="project-hero__status">
          <span aria-hidden="true"></span>
          {project.status}
        </p>
        {project.repositoryUrl && (
          <a
            class="project-hero__repo"
            href={project.repositoryUrl}
            target="_blank"
            rel="noopener noreferrer"
            lang="en"
          >
            <span>GitHub</span>
            <span aria-hidden="true">↗</span>
          </a>
        )}
        <div class="project-hero__focus">
          <p class="eyebrow" lang="en">{labels.focus}</p>
          <ul aria-label={`${project.name} ${labels.focusAriaSuffix}`}>
            {project.focus.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>

    {heroMedia.map((asset) => (
      <figure class:list={['project-figure', asset.kind === 'screenshot' && 'project-figure--shot']}>
        <picture>
          {asset.mobileSrc && (
            <source
              media="(max-width: 1023px)"
              srcset={asset.mobileSrc}
              width={asset.mobileWidth}
              height={asset.mobileHeight}
            />
          )}
          <img
            src={asset.src}
            alt={asset.alt}
            width={asset.width}
            height={asset.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        {asset.caption && <figcaption>{asset.caption}</figcaption>}
      </figure>
    ))}
  </div>
</header>
