---
import type { SiteContent } from '../i18n/types';
import { routeFor } from '../i18n/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGroups from './ProjectGroups.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { home } = content;
---

<BaseLayout content={content} pageKey="home">
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow hero__eyebrow" lang={content.locale === 'en' ? 'en' : undefined}>
          <span aria-hidden="true"></span>
          {home.hero.kicker}
        </p>
        <div class="hero__mark-mobile" aria-hidden="true">
          <img
            src="/brand/xuanheng-mark.svg"
            alt=""
            width="1002"
            height="1576"
          />
        </div>
        <h1>{home.hero.title}</h1>
        <p class="hero__statement">
          <span>{home.hero.statement[0]}</span><br />
          <span>{home.hero.statement[1]}</span>
        </p>
        <div class="hero__intro">
          {home.hero.intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="hero__actions">
          <a class="button button--primary" href={routeFor(content.locale, 'projects')}>
            <span>{home.hero.primaryCta}</span>
            <span aria-hidden="true">→</span>
          </a>
          <a class="button button--secondary" href={routeFor(content.locale, 'about')}>
            <span>{home.hero.secondaryCta}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <aside class="hero__index" aria-label={home.hero.brandMarkLabel}>
        <div class="hero__mark-frame" aria-hidden="true">
          <img
            class="hero__mark"
            src="/brand/xuanheng-mark.svg"
            alt=""
            width="1002"
            height="1576"
          />
        </div>
        <div class="hero__signature" lang={content.locale === 'en' ? 'en' : undefined}>
          {home.hero.signature.map((line) => <p>{line}</p>)}
        </div>
      </aside>
    </div>
  </section>

  <section class="section projects-preview" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-heading section-heading--action">
        <div>
          <p class="eyebrow" lang="en">{home.selectedProjects.kicker}</p>
          <h2 id="projects-title">{home.selectedProjects.title}</h2>
        </div>
        <a class="text-link" href={routeFor(content.locale, 'projects')}>
          <span>{home.selectedProjects.viewAll}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <ProjectGroups content={content} titleIdPrefix="home-group" />
    </div>
  </section>

  <section class="section research" aria-labelledby="research-title">
    <div class="container">
      <div class="section-heading section-heading--light">
        <div>
          <p class="eyebrow" lang="en">{home.research.kicker}</p>
          <h2 id="research-title">{home.research.title}</h2>
        </div>
        <p class="section-heading__lead">
          {home.research.lead[0]}
          {home.research.lead[1] && <><br />{home.research.lead[1]}</>}
        </p>
      </div>

      <div class="research__list">
        {home.research.areas.map((area) => (
          <article class="research__item">
            <span class="research__number">{area.index}</span>
            <h3>{area.title}</h3>
            <p>{area.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section about-preview" aria-labelledby="about-title">
    <div class="container about-preview__grid">
      <div>
        <p class="eyebrow" lang="en">{home.aboutPreview.kicker}</p>
        <h2 id="about-title">{home.aboutPreview.title}</h2>
      </div>
      <div class="about-preview__content">
        <p class="about-preview__lead">{home.philosophy.lead}</p>
        <div class="philosophy-concepts">
          {home.philosophy.concepts.map((concept) => (
            <p class="philosophy-concepts__item">
              <span class="philosophy-concepts__symbol" aria-hidden="true">{concept.symbol}</span>
              <span>{concept.description}</span>
            </p>
          ))}
        </div>
        <p>{home.aboutPreview.lead}</p>
        {home.aboutPreview.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <a class="text-link" href={routeFor(content.locale, 'about')}>
          <span>{home.aboutPreview.linkLabel}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="contact-band" aria-labelledby="contact-title">
    <div class="container contact-band__inner">
      <div>
        <p class="eyebrow" lang="en">{home.contact.kicker}</p>
        <h2 id="contact-title">{home.contact.title}</h2>
      </div>
      <a href="mailto:contact@xuanhengtech.cn">
        <span>contact@xuanhengtech.cn</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
