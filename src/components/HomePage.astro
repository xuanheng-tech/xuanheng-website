---
import type { SiteContent } from '../i18n/types';
import { groupsForSection, routeFor } from '../i18n/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from './BrandMark.astro';
import OpenSourceChain from './OpenSourceChain.astro';
import ProductRow from './ProductRow.astro';
import ProjectCard from './ProjectCard.astro';
import TrustStrip from './TrustStrip.astro';
import UpdatesList from './UpdatesList.astro';
import { organization, website } from '../i18n/structured-data';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { home } = content;
const latin = content.locale === 'en' ? 'en' : undefined;
const demoHref = `${routeFor(content.locale, 'contact')}#demo`;
const products = content.projects.filter((project) => groupsForSection.products.includes(project.group));
const research = content.projects.filter((project) => groupsForSection.research.includes(project.group));
---

<BaseLayout content={content} pageKey="home" structuredData={[organization(content), website(content)]}>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow hero__eyebrow" lang={latin}>
          <span aria-hidden="true"></span>
          {home.hero.kicker}
        </p>
        <h1 class="hero__title">
          <span>{home.hero.title[0]}</span>
          <span>{home.hero.title[1]}</span>
        </h1>
        <p class="hero__intro">{home.hero.intro}</p>
        <div class="hero__actions">
          <a class="button button--accent" href={demoHref}>
            <span>{home.hero.primaryCta}</span>
            <span aria-hidden="true">→</span>
          </a>
          <a class="button button--secondary" href={routeFor(content.locale, 'products')}>
            <span>{home.hero.secondaryCta}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <aside class="hero__index" aria-label={home.hero.brandMarkLabel}>
        <div class="hero__mark-frame" aria-hidden="true">
          <BrandMark class="hero__mark" />
        </div>
        <div class="hero__signature">
          {home.hero.signature.map((line) => <p>{line}</p>)}
        </div>
      </aside>
    </div>
  </section>

  <TrustStrip trust={home.trust} />

  <section class="section home-products" aria-labelledby="home-products-title">
    <div class="container">
      <div class="section-heading section-heading--action">
        <div>
          <p class="eyebrow" lang={latin}>{home.products.kicker}</p>
          <h2 id="home-products-title">{home.products.title}</h2>
        </div>
        <p class="section-heading__lead">{home.products.lead}</p>
      </div>
      <div class="product-rows">
        {products.map((project) => <ProductRow content={content} project={project} />)}
      </div>
    </div>
  </section>

  <section class="section oss-band" aria-labelledby="home-oss-title">
    <div class="container">
      <div class="section-heading section-heading--light section-heading--action">
        <div>
          <p class="eyebrow" lang={latin}>{home.openSource.kicker}</p>
          <h2 id="home-oss-title">{home.openSource.title}</h2>
        </div>
        <p class="section-heading__lead">{home.openSource.lead}</p>
      </div>
      <OpenSourceChain content={content} headingId="home-oss-chain" />
      <a class="text-link oss-band__link" href={routeFor(content.locale, 'openSource')}>
        <span>{home.openSource.viewAll}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="section home-research" aria-labelledby="home-research-title">
    <div class="container">
      <div class="section-heading section-heading--action">
        <div>
          <p class="eyebrow" lang={latin}>{home.research.kicker}</p>
          <h2 id="home-research-title">{home.research.title}</h2>
        </div>
        <a class="text-link" href={routeFor(content.locale, 'research')}>
          <span>{home.research.viewAll}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="card-grid">
        {research.map((project) => <ProjectCard project={project} labels={content.projectLabels} />)}
      </div>
    </div>
  </section>

  <section class="section about-preview" aria-labelledby="about-title">
    <div class="container about-preview__grid">
      <div>
        <p class="eyebrow" lang={latin}>{home.aboutPreview.kicker}</p>
        <h2 id="about-title">{home.aboutPreview.title}</h2>
      </div>
      <div class="about-preview__content">
        <p class="about-preview__lead">{home.philosophy.lead}</p>
        <div class="philosophy-concepts">
          {home.philosophy.concepts.map((concept) => (
            <p class="philosophy-concepts__item">
              <span class="philosophy-concepts__symbol" aria-hidden="true">{concept.symbol}</span>
              <span>{concept.description}</span>
            </p>
          ))}
        </div>
        <p>{home.aboutPreview.lead}</p>
        {home.aboutPreview.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <a class="text-link" href={routeFor(content.locale, 'about')}>
          <span>{home.aboutPreview.linkLabel}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section home-updates" aria-labelledby="home-updates-title">
    <div class="container">
      <div class="section-heading section-heading--action">
        <div>
          <p class="eyebrow" lang={latin}>{content.updates.home.kicker}</p>
          <h2 id="home-updates-title">{content.updates.home.title}</h2>
        </div>
        <a class="text-link" href={routeFor(content.locale, 'updates')}>
          <span>{content.updates.home.viewAll}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <UpdatesList entries={content.updates.entries.slice(0, 3)} level={3} />
    </div>
  </section>

  <section class="contact-band" aria-labelledby="contact-title">
    <div class="container contact-band__inner">
      <div>
        <p class="eyebrow" lang={latin}>{home.contact.kicker}</p>
        <h2 id="contact-title">{home.contact.title}</h2>
      </div>
      <div class="contact-band__body">
        <div class="contact-band__actions">
          <a class="button button--accent" href={demoHref}>
            <span>{content.chrome.demoCta}</span>
            <span aria-hidden="true">→</span>
          </a>
          <a class="contact-band__email" href="mailto:contact@xuanhengtech.cn">
            <span>contact@xuanhengtech.cn</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="contact-band__phone">
          <span>{content.contact.phone.label}</span><a href={content.contact.phone.href}>{content.contact.phone.display}</a>
          <span>{content.contact.phone.hours}</span>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
