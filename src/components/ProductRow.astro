---
import { routeFor } from '../i18n/routes';
import type { ProjectCopy, SiteContent } from '../i18n/types';

interface Props {
  content: SiteContent;
  project: ProjectCopy;
}

const { content, project } = Astro.props;
const labels = content.projectLabels;
---

<article class="product-row">
  <div class="product-row__identity">
    <p class="product-row__meta" lang="en">{labels.project} {project.number} · {project.category}</p>
    <h3><a href={project.detailPath}>{project.name}</a></h3>
    {project.englishName !== project.name && (
      <p class="product-row__english" lang="en">{project.englishName}</p>
    )}
    {project.slogan && <p class="product-row__slogan">{project.slogan}</p>}
    <p class="product-row__summary">{project.summary}</p>
    <div class="product-row__actions">
      <span class="status-pill" data-group={project.group}>{project.status}</span>
      <a class="text-link" href={project.detailPath}>
        <span>{labels.viewProject}</span>
        <span aria-hidden="true">→</span>
      </a>
      {project.demoCta && (
        <a class="text-link text-link--accent" href={`${routeFor(content.locale, 'contact')}#demo`}>
          <span>{project.demoCta}</span>
          <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
  </div>
  <ol class="product-row__capabilities">
    {project.capabilities.map((capability, index) => (
      <li>
        <span class="product-row__index" lang="en">{String(index + 1).padStart(2, '0')}</span>
        <div>
          <h4>{capability.name}</h4>
          <p>{capability.description}</p>
        </div>
      </li>
    ))}
  </ol>
</article>
