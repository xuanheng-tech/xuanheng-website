---
import type { HomeCopy } from '../i18n/types';

interface Props {
  trust: HomeCopy['trust'];
}

const { trust } = Astro.props;
---

<section class="trust-strip" aria-label={trust.label}>
  <ul class="container trust-strip__list">
    {trust.items.map((item) => (
      <li>
        {/* Icons: Lucide (lucide.dev) v0.460.0, ISC License.
            Copyright (c) Lucide Contributors 2022; portions Cole Bemis 2013-2022 (Feather, MIT). */}
        <svg viewBox="0 0 24 24" aria-hidden="true">
          {item.icon === 'source' && <><path d="M14 2v4a2 2 0 0 0 2 2h4" /><path d="M4.268 21a2 2 0 0 0 1.727 1H18a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v3" /><path d="m9 18-1.5-1.5" /><circle cx="5" cy="14" r="3" /></>}
          {item.icon === 'boundary' && <><path d="m12 14 4-4" /><path d="M3.34 19a10 10 0 1 1 17.32 0" /></>}
          {item.icon === 'review' && <><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><polyline points="16 11 18 13 22 9" /></>}
          {item.icon === 'private' && <><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path d="m9 12 2 2 4-4" /></>}
        </svg>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
      </li>
    ))}
  </ul>
</section>
