---
import type { HomeCopy } from '../i18n/types';

interface Props {
  trust: HomeCopy['trust'];
}

const { trust } = Astro.props;
---

<section class="trust-strip" aria-label={trust.label}>
  <ul class="container trust-strip__list">
    {trust.items.map((item) => (
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          {item.icon === 'source' && <><path d="M6 3h9l4 4v14H6z" /><path d="M14 3v5h5M9 13h7M9 17h4" /></>}
          {item.icon === 'boundary' && <><path d="M3 12h18M12 3v18" stroke-dasharray="2 3" /><rect x="6" y="7" width="12" height="10" /></>}
          {item.icon === 'review' && <><circle cx="9" cy="8" r="3.5" /><path d="M3 20c.8-3.5 3.2-5.5 6-5.5s5.2 2 6 5.5M15 11l2 2 4-4" /></>}
          {item.icon === 'private' && <><rect x="5" y="10" width="14" height="10" /><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v2" /></>}
        </svg>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
      </li>
    ))}
  </ul>
</section>
