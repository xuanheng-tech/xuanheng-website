---
import type { SiteContent } from '../i18n/types';

interface Props {
  content: SiteContent;
  class?: string;
}

const { content, class: className } = Astro.props;
const options = ['light', 'dark', 'system'] as const;
---

<div class:list={['theme-switch', className]} role="group" aria-label={content.chrome.themeSwitchLabel}>
  {options.map((option) => (
    <button
      type="button"
      data-theme-choice={option}
      aria-pressed={option === 'system' ? 'true' : 'false'}
      aria-label={content.chrome.themeOptions[option]}
      title={content.chrome.themeOptions[option]}
    >
      {option === 'light' && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" /></svg>
      )}
      {option === 'dark' && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
      )}
      {option === 'system' && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path class="theme-switch__fill" d="M12 4a8 8 0 0 1 0 16z" /></svg>
      )}
    </button>
  ))}
</div>
