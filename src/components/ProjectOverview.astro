---
interface Props {
  title: string;
  paragraphs: string[];
}

const { title, paragraphs } = Astro.props;
---

<section class="project-section project-overview" aria-labelledby="project-overview-title">
  <div class="container project-section__grid">
    <header class="project-section__heading">
      <p class="eyebrow" lang="en">01 · Overview</p>
      <h2 id="project-overview-title">{title}</h2>
    </header>
    <div class="project-overview__copy">
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>
