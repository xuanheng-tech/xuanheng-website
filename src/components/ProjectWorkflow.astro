---
interface Props {
  title: string;
  eyebrow?: string;
  steps: string[];
}

const { title, eyebrow, steps } = Astro.props;
---

<section class="project-section project-workflow" aria-labelledby="project-workflow-title">
  <div class="container">
    <header class="project-section__heading project-section__heading--row">
      <div>
        <p class="eyebrow" lang="en">03 · {eyebrow ?? 'Workflow'}</p>
        <h2 id="project-workflow-title">{title}</h2>
      </div>
    </header>
    <ol class="project-workflow__steps">
      {steps.map((step, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <p>{step}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
