---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { routeFor } from '../i18n/routes';
import type { PageKey, SeoCopy, SiteContent } from '../i18n/types';
import '../styles/global.css';

interface Props {
  content: SiteContent;
  pageKey: PageKey;
  activePage?: PageKey | null;
  canonicalPath?: string;
  englishPath?: string;
  chinesePath?: string;
  seo?: SeoCopy;
  faviconHref?: string;
  markSrc?: string;
  indexable?: boolean;
}

const defaultFaviconHref = '/brand/xuanheng-mark.svg';
const defaultMarkSrc = '/brand/xuanheng-mark.svg';

const {
  content,
  pageKey,
  activePage = pageKey,
  canonicalPath: canonicalPathOverride,
  englishPath: englishPathOverride,
  chinesePath: chinesePathOverride,
  seo,
  faviconHref = defaultFaviconHref,
  markSrc = defaultMarkSrc,
  indexable = true,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://xuanhengtech.cn');
const canonicalPath = canonicalPathOverride ?? routeFor(content.locale, pageKey);
const englishPath = englishPathOverride ?? routeFor('en', pageKey);
const chinesePath = chinesePathOverride ?? routeFor('zh', pageKey);
const canonicalUrl = new URL(canonicalPath, siteUrl);
const englishUrl = new URL(englishPath, siteUrl);
const chineseUrl = new URL(chinesePath, siteUrl);
const { title, description } = seo ?? content.seo[pageKey];
---

<!doctype html>
<html lang={content.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F6F1E8" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {indexable ? (
      <>
        <link rel="canonical" href={canonicalUrl} />
        <link rel="alternate" hreflang="en" href={englishUrl} />
        <link rel="alternate" hreflang="zh-CN" href={chineseUrl} />
        <link rel="alternate" hreflang="x-default" href={englishUrl} />
      </>
    ) : (
      <meta name="robots" content="noindex, nofollow" />
    )}
    <link rel="icon" href={faviconHref} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="玄衡科技 | Xuanheng Technology" />
    <meta property="og:locale" content={content.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {indexable && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">{content.chrome.skipToContent}</a>
    <Header
      content={content}
      pageKey={pageKey}
      activePage={activePage}
      englishPath={englishPath}
      chinesePath={chinesePath}
      markSrc={markSrc}
    />
    <main id="main-content">
      <slot />
    </main>
    <Footer content={content} />
  </body>
</html>
