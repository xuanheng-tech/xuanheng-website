---
import Footer from '../components/Footer.astro';
import BrandSymbol from '../components/BrandSymbol.astro';
import Header from '../components/Header.astro';
import { routeFor } from '../i18n/routes';
import type { PageKey, SeoCopy, SiteContent } from '../i18n/types';
import '../styles/global.css';

interface Props {
  content: SiteContent;
  pageKey: PageKey;
  activePage?: PageKey | null;
  canonicalPath?: string;
  englishPath?: string;
  chinesePath?: string;
  seo?: SeoCopy;
  faviconHref?: string;
  indexable?: boolean;
}

const defaultFaviconHref = '/brand/xuanheng-mark.svg';

const {
  content,
  pageKey,
  activePage = pageKey,
  canonicalPath: canonicalPathOverride,
  englishPath: englishPathOverride,
  chinesePath: chinesePathOverride,
  seo,
  faviconHref = defaultFaviconHref,
  indexable = true,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://www.xuanhengtech.cn');
const canonicalPath = canonicalPathOverride ?? routeFor(content.locale, pageKey);
const englishPath = englishPathOverride ?? routeFor('en', pageKey);
const chinesePath = chinesePathOverride ?? routeFor('zh', pageKey);
const canonicalUrl = new URL(canonicalPath, siteUrl);
const englishUrl = new URL(englishPath, siteUrl);
const chineseUrl = new URL(chinesePath, siteUrl);
const { title, description } = seo ?? content.seo[pageKey];
---

<!doctype html>
<html lang={content.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F6F1E8" media="(prefers-color-scheme: light)" data-scheme="light" />
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" data-scheme="dark" />
    <meta name="color-scheme" content="light dark" />
    {/* Applies a saved manual theme before first paint so the page never flashes the
        other theme. Without JavaScript the site still follows the system setting. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let saved = null;
        try { saved = localStorage.getItem('xh-theme'); } catch { /* storage blocked: follow system */ }
        if (saved === 'light' || saved === 'dark') root.dataset.theme = saved;
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {indexable ? (
      <>
        <link rel="canonical" href={canonicalUrl} />
        <link rel="alternate" hreflang="en" href={englishUrl} />
        <link rel="alternate" hreflang="zh-CN" href={chineseUrl} />
        <link rel="alternate" hreflang="x-default" href={englishUrl} />
      </>
    ) : (
      <meta name="robots" content="noindex, nofollow" />
    )}
    <link rel="icon" href={faviconHref} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="玄衡科技 | Xuanheng Technology" />
    <meta property="og:locale" content={content.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {indexable && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">{content.chrome.skipToContent}</a>
    <Header
      content={content}
      pageKey={pageKey}
      activePage={activePage}
      englishPath={englishPath}
      chinesePath={chinesePath}
    />
    <main id="main-content">
      <slot />
    </main>
    <Footer content={content} />
    <BrandSymbol />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const colors = { light: '#F6F1E8', dark: '#141311' };
        const metas = document.querySelectorAll('meta[name="theme-color"]');
        const apply = (choice) => {
          if (choice === 'system') delete root.dataset.theme;
          else root.dataset.theme = choice;
          metas.forEach((meta) => {
            meta.content = colors[choice === 'system' ? meta.dataset.scheme : choice];
          });
          document.querySelectorAll('[data-theme-choice]').forEach((button) => {
            button.setAttribute('aria-pressed', String(button.dataset.themeChoice === choice));
          });
        };
        apply(root.dataset.theme ?? 'system');
        document.addEventListener('click', (event) => {
          const button = event.target.closest('[data-theme-choice]');
          if (!button) return;
          const choice = button.dataset.themeChoice;
          try {
            if (choice === 'system') localStorage.removeItem('xh-theme');
            else localStorage.setItem('xh-theme', choice);
          } catch { /* storage blocked: the choice lasts for this page view */ }
          apply(choice);
        });
      })();
    </script>
  </body>
</html>
