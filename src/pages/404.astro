---
import BaseLayout from '../layouts/BaseLayout.astro';
import { zh } from '../i18n/zh';

const homeRoutes = {
  zh: '/',
  en: '/en/',
};

const seo = {
  title: '页面未找到 | Page Not Found | 玄衡科技',
  description: '你访问的页面不存在或已移动。The page you requested could not be found.',
};
---

<BaseLayout
  content={zh}
  pageKey="home"
  activePage={null}
  localeRoutes={homeRoutes}
  seo={seo}
  indexable={false}
>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="container not-found__inner">
      <div class="not-found__heading">
        <p class="eyebrow" lang="en">404 · PAGE NOT FOUND</p>
        <p class="not-found__code" aria-hidden="true">404</p>
        <h1 id="not-found-title">页面未找到</h1>
        <p class="not-found__english-title" lang="en">Page Not Found</p>
      </div>

      <div class="not-found__copy">
        <p>你访问的页面不存在或已移动。</p>
        <p lang="en">The page you requested could not be found.</p>
        <div class="not-found__actions">
          <a class="button button--primary" href="/">
            <span>返回中文首页</span>
            <span aria-hidden="true">→</span>
          </a>
          <a class="button button--secondary" href="/en/" lang="en">
            <span>English Home</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
